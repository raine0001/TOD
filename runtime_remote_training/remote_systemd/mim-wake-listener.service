[Unit]
Description=MIM Wake Listener
After=default.target speech-dispatcher.service pipewire-pulse.service
Wants=speech-dispatcher.service pipewire-pulse.service

[Service]
Type=simple
WorkingDirectory=/home/testpilot/mim
Environment=MIM_WAKE_AUDIO_DEVICE=plughw:2,0;default;plughw:0,0;plughw:3,0;plughw:3,2
Environment=MIM_WAKE_CHUNK_SECONDS=4
Environment=MIM_WAKE_IDLE_SECONDS=0.5
Environment=MIM_WAKE_COOLDOWN_SECONDS=6
Environment=MIM_WAKE_DIAGNOSTIC=1
Environment=MIM_WAKE_FOLLOWUP=1
Environment=MIM_WAKE_FOLLOWUP_SECONDS=8
Environment=MIM_VOICE_ACTIVE_SESSION_SECONDS=90
Environment=MIM_LAB_CONVERSATION_MODE=1
Environment=MIM_VOICE_UI_CHAT_BRIDGE=1
Environment=MIM_VOICE_UI_CHAT_SESSION_ID=mim-ambient-lab-voice-ui-chat
Environment=MIM_VOICE_TRANSCRIPT_LOG=1
Environment=MIM_VOICE_TRANSCRIPT_LOG_MAX_LINES=500
Environment=MIM_VOICE_PIPER_MODEL=/home/testpilot/mim/runtime/models/piper/en_US-arctic-medium/en_US-arctic-medium.onnx
Environment=MIM_VOICE_PIPER_LENGTH_SCALE=0.78
Environment=MIM_VOICE_PIPER_NOISE_SCALE=0.46
Environment=MIM_VOICE_PIPER_NOISE_W_SCALE=0.62
Environment=MIM_VOICE_PIPER_VOLUME=1.16
Environment=MIM_OPERATOR_TIMEZONE=America/Los_Angeles
ExecStart=/home/testpilot/mim/.venv/bin/python /home/testpilot/mim/scripts/mim_wake_listen_loop.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
